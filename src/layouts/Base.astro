---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Milana Kachanava — Senior Product Designer',
  description = 'Senior Product Designer who turns scattered data into decisions people can act on. Trust & safety, fleet operations, complex B2B SaaS.',
} = Astro.props;
const cv = '/Milana_Kachanava_Senior_Product_Designer_CV.pdf';
const email = 'milana.kachanava@gmail.com';

const stats = [
  { n: '0 → 1', t: 'new paid fraud-prevention product, from research to first paying customers' },
  { n: '20+ → 7', t: 'steps to connect a CRM after my redesign of PandaDoc integrations' },
  { n: '4 → 1', t: 'sources a shipper checks, merged into one carrier profile' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="shell">
      <aside class="side">
        <div class="side-inner">
          <div class="coords"><span>52°13′ N 21°01′ E</span><span>Warsaw · <span id="clock">CET</span></span></div>
          <a class="me" href="/">
            <span class="name">Milana<br />Kachanava</span>
            <span class="role">Senior Product Designer</span>
          </a>

          <p class="intro">Senior product designer with 10+ years on complex B2B products. At Super Dispatch I led <a href="/work/superprotect/">SuperProtect</a>, a new fraud-prevention product, from shipper research to a paid release. At 90 Percent of Everything I grew <a href="/work/onradar/">onRADAR</a> from an alerts MVP into a live fleet operations platform and shipped its <a href="/work/openocean-mobile/">iOS and Android app</a>. Before that: <a href="/work/pandadoc-integrations/">CRM integrations</a> at PandaDoc, enterprise products for Thomson Reuters and Schneider Electric.</p>

          <ul class="stats">
            {stats.map((s) => <li><b>{s.n}</b> {s.t}</li>)}
          </ul>

          <nav class="side-nav">
            <a href="/#work"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/></svg>Work</a>
            <a href="/#ai"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l1.9 4.6L18.5 9l-4.6 1.9L12 15.5l-1.9-4.6L5.5 9l4.6-1.4z"/><path d="M18 15l.8 2.2L21 18l-2.2.8L18 21l-.8-2.2L15 18l2.2-.8z"/></svg>Built with AI</a>
            <a href="/#about"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4"/><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6"/></svg>About</a>
            <a href={cv} target="_blank"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M9 13h6M9 17h6"/></svg>Resume <small>PDF ↗</small></a>
            <a href="https://www.linkedin.com/in/lanakachanova/" target="_blank"><svg class="ico" viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 11v6M8 7.5v.01M12 17v-6M12 13.5c0-1.5 1-2.5 2.5-2.5S17 12 17 13.5V17"/></svg>LinkedIn <small>↗</small></a>
          </nav>

          <button type="button" class="reach" id="reach" data-email={email} title={email}><span class="reach-label">Reach out</span></button>
        </div>
      </aside>

      <main class="main">
        <slot />
        <footer class="site-footer">
          <span>© {new Date().getFullYear()} Milana Kachanava</span>
          <a href={`mailto:${email}`}>{email}</a>
        </footer>
      </main>
    </div>
    <script>
      const el = document.getElementById('clock');
      const tick = () => { if (el) el.textContent = new Intl.DateTimeFormat('en-GB', { timeZone: 'Europe/Warsaw', hour: '2-digit', minute: '2-digit' }).format(new Date()); };
      tick(); setInterval(tick, 30000);
      const reach = document.getElementById('reach');
      if (reach) reach.addEventListener('click', () => {
        const mail = reach.dataset.email || '';
        const label = reach.querySelector('.reach-label');
        const show = (txt) => { if (!label) return; label.textContent = txt; setTimeout(() => { label.textContent = 'Reach out'; }, 2600); };
        if (navigator.clipboard) navigator.clipboard.writeText(mail).then(() => show('Email copied ✓'), () => show(mail));
        else show(mail);
      });
    </script>
  </body>
</html>
