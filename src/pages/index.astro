---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const email = 'milana.kachanava@gmail.com';
---
<Base>
  <div class="stream" id="work">
    {work.map((w) => (
      <a class="project" href={`/work/${w.id}/`}>
        <div class="shot">{w.data.company} · screenshot</div>
        <div class="info">
          <div>
            <h2>{w.data.title}</h2>
            <div class="meta">
              {w.data.company}: {w.data.tags.slice(0, 2).join(', ')}<br />
              {w.data.role.split(',')[0]} · {w.data.years}
            </div>
          </div>
          <p class="outcome">{w.data.card}</p>
        </div>
      </a>
    ))}
  </div>

  <section class="section" id="about">
    <h2>About</h2>
    <p>I'm a senior product designer with 10+ years on complex B2B products. Most of my work sits at the moment someone has to decide under pressure: a shipper choosing a carrier, an operator handling a vessel alert at night, a sales admin connecting a CRM without breaking their data.</p>
    <p>At Super Dispatch I led design for SuperProtect, a fraud-prevention product that went from shipper interviews to a paid release in 9 months. At 90 Percent of Everything I spent more than three years growing onRADAR from an alerts MVP into a live fleet operations platform on web, desktop and mobile. Before that: CRM integrations at PandaDoc, Kaseya's RMM platform, and enterprise projects for Thomson Reuters, Schneider Electric and METRO at EPAM.</p>
    <p>I prototype in code with Claude, Codex and Cursor, so ideas reach users while there is still time to change direction. I also run workshops that help a team hear each other and decide.</p>
  </section>

  <section class="section" id="contact">
    <h2>Contact</h2>
    <p>Open to senior product design roles, remote or hybrid.</p>
    <ul class="facts">
      <li><span>Email</span><a href={`mailto:${email}`}>{email}</a></li>
      <li><span>LinkedIn</span><a href="https://www.linkedin.com/in/lanakachanova/" target="_blank">linkedin.com/in/lanakachanova</a></li>
      <li><span>Location</span><span>Warsaw, Poland · CET</span></li>
      <li><span>Work authorization</span><span>Polish residence card, no sponsorship needed</span></li>
      <li><span>Languages</span><span>English C1 · Polish B2 · Russian native</span></li>
    </ul>
  </section>
</Base>
