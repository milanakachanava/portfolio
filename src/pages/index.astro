---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { aiProjects } from '../data/ai-projects';

const work = (await getCollection('work')).sort((a, b) => a.data.order - b.data.order);
const email = 'milana.kachanava@gmail.com';
const pad = (n: number) => String(n).padStart(2, '0');

const experience = [
  { y: '2025–2026', c: 'Super Dispatch', r: 'Senior Product Designer', d: 'Auto-transport marketplace · Trust & Safety' },
  { y: '2021–2025', c: '90 Percent of Everything', r: 'Senior Product Designer', d: 'Maritime SaaS · fleet operations' },
  { y: '2020–2021', c: 'Kaseya', r: 'Senior UX Designer', d: 'IT management · RMM platform' },
  { y: '2019–2020', c: 'PandaDoc', r: 'Product Designer', d: 'Sales documents · CRM integrations' },
  { y: '2017–2019', c: 'EPAM Systems', r: 'UX Designer', d: 'Thomson Reuters, Schneider Electric, METRO, MeteoGroup' },
  { y: '2014–2017', c: 'Devicepros, Qulix Systems', r: 'UX and UI/UX Designer', d: 'Test automation, web and mobile apps' },
];

const skills = [
  { k: 'Product design', v: 'Problem framing, information architecture, data-dense dashboards, alert and workflow design, risk and trust signals, cross-platform design' },
  { k: 'Research', v: 'Interviews, contextual observation, usability testing, competitive analysis, product analytics (Heap, Fullstory)' },
  { k: 'Design systems', v: 'Figma libraries, tokens, mobile design systems, shared patterns, developer-ready specs' },
  { k: 'AI and prototyping', v: 'Prototypes and small products in code with Claude, Codex and Cursor; Figma Make' },
  { k: 'Facilitation', v: 'Workshops, prioritisation with PM and engineering, cross-team design standards' },
];
---
<Base>
  <div class="stream" id="work">
    {work.map((w, i) => (
      <a class="project" href={`/work/${w.id}/`}>
        <div class="shot"><img src={`/work/${w.id}/cover.webp`} alt={w.data.title} loading="lazy" /></div>
        <div class="info">
          <div>
            <span class="num">{pad(i + 1)} / {pad(work.length)}</span>
            <h2>{w.data.title}</h2>
            <div class="meta">
              {w.data.company}: {w.data.tags.slice(0, 2).join(', ')}<br />
              {w.data.role.split(',')[0]} · {w.data.years}
            </div>
          </div>
          <p class="outcome">{w.data.card}</p>
        </div>
      </a>
    ))}
  </div>

  <section class="section" id="ai">
    <p class="eyebrow">Side projects</p>
    <h2>Built with AI</h2>
    <p>Small products I design and build end to end with AI coding tools: the idea, the model behind it, the interface and the code.</p>
    <div class="ai-list">
      {aiProjects.map((p) => (
        <a class="ai-card" href={p.url} target="_blank" rel="noopener">
          <div class="shot"><img src={p.cover} alt={p.title} loading="lazy" /></div>
          <div class="ai-info">
            <div class="meta">{p.kind} · {p.status} · {p.year} · {p.language}</div>
            <h3>{p.title} <span class="arrow">↗</span></h3>
            <p>{p.text}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="section" id="about">
    <p class="eyebrow">About</p>
    <h2>Milana Kachanava</h2>
    <p>I'm a senior product designer with 10+ years on complex B2B products. Most of my work sits at the moment someone has to decide under pressure: a shipper choosing a carrier, an operator handling a vessel alert at night, a sales admin connecting a CRM without breaking their data.</p>
    <p>At Super Dispatch I led design for SuperProtect, a fraud-prevention product that went from ~20 shipper interviews to a paid release and its first paying customers. At 90 Percent of Everything I grew onRADAR from an alerts MVP into a live fleet operations platform on web, desktop and mobile, and designed a crew app where seafarers manage their documents, status, travel and assignments. Before that: integrations with 6 CRMs at PandaDoc, with CRM data available right inside the document editor, Kaseya's RMM platform, and banking, enterprise and maritime logistics projects at EPAM for clients including Thomson Reuters, Schneider Electric and METRO.</p>
    <p>I run workshops that help a team hear each other and decide, and I was a mentor at EPAM's UX Camp.</p>

    <h3 class="sub-h">Experience</h3>
    <ul class="facts exp">
      {experience.map((e) => (
        <li><span>{e.y}</span><span><b>{e.c}</b> · {e.r}<br /><small>{e.d}</small></span></li>
      ))}
    </ul>

    <h3 class="sub-h">Skills</h3>
    <ul class="facts">
      {skills.map((s) => <li><span>{s.k}</span><span>{s.v}</span></li>)}
    </ul>

    <h3 class="sub-h">How I use AI</h3>
    <p class="ai-note">I use AI for desk research before interviews, for turning interview notes, transcripts and analytics into themes that I then check against the source, for working prototypes in code with Claude, Codex and Cursor, and for finding references. What stays mine is choosing the direction. AI gives many options fast: some are wrong, some sound right but miss the point. Picking the one worth building takes the users' context, the business and technical constraints, and judgement from 10+ years on B2B products. Personal and client data stays out of tools the company has not approved.</p>

    <h3 class="sub-h">Education</h3>
    <ul class="facts">
      <li><span>2013–2017</span><span>Media and Visual Design, European Humanities University</span></li>
      <li><span>2016–2017</span><span>UX Design: service design, product analytics and metrics, Skillbox</span></li>
      <li><span>2018</span><span>UX Camp, EPAM Systems, as mentor and mentee</span></li>
    </ul>

    <h3 class="sub-h">Beyond the screen</h3>
    <div class="life">
      <div class="life-text">
        <p class="life-meta">EPAM · 2017–2019</p>
        <h4>Mentoring junior designers</h4>
        <p>I mentored junior designers, each running their own internal project. In parallel, we mentors ran a project of our own and presented a solution to improve the internal learning processes on the platform.</p>
      </div>
      <div class="life-grid">
        <figure class="w2 h2"><img src="/life/talk.webp" alt="Presenting the mentors' internal-process project to an audience at EPAM" loading="lazy" /></figure>
        <figure class="sm"><img src="/life/talk-stage.webp" alt="Q&amp;A after the presentation" loading="lazy" /></figure>
        <figure class="sm"><img src="/life/workshop-kit.webp" alt="Workshop kit: sticky notes, markers and prompt cards" loading="lazy" /></figure>
        <figure class="h3"><img src="/life/epam-talk.webp" alt="Milana presenting the results slide" loading="lazy" style="object-position:30% 50%" /></figure>
        <figure class="w2 h3"><img src="/life/epam-team.webp" alt="Mentors and junior designers of the EPAM mentoring program" loading="lazy" /></figure>
      </div>

      <div class="life-text">
        <p class="life-meta">MeteoGroup · Marseille, France</p>
        <h4>Field research in a weather-routing centre</h4>
        <p>Part of a UX audit and research for MeteoGroup's ship weather-routing system. I visited their routing centre and ran service design workshops with ship captains and navigation officers.</p>
      </div>
      <div class="life-grid">
        <figure class="w3 h2"><img src="/life/ops-centre.webp" alt="MeteoGroup weather-routing operations centre with a wall of map screens" loading="lazy" /></figure>
      </div>
    </div>
  </section>

  <section class="section" id="contact">
    <p class="eyebrow">Contact</p>
    <h2>Let's talk</h2>
    <p>Open to senior product design roles, remote or hybrid.</p>
    <ul class="facts">
      <li><span>Email</span><a href={`mailto:${email}`}>{email}</a></li>
      <li><span>LinkedIn</span><a href="https://www.linkedin.com/in/lanakachanova/" target="_blank">linkedin.com/in/lanakachanova</a></li>
      <li><span>Location</span><span>Warsaw, Poland · CET</span></li>
      <li><span>Work authorization</span><span>Polish residence card, no sponsorship needed</span></li>
      <li><span>Languages</span><span>English C1 · Polish B2 · Russian native</span></li>
    </ul>
  </section>
</Base>
